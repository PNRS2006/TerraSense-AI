# ============================================================
# CERIP — .env.example
# Copy to .env and fill in real credentials (all optional —
# the prototype runs entirely on synthetic data without them)
# ============================================================

# --- IMD (India Meteorological Department) ---
# IMD_API_KEY=your_imd_api_key_here
# IMD_BASE_URL=https://imdpune.gov.in/

# --- ISRO Bhuvan / Bhoonidhi ---
# ISRO_API_KEY=your_isro_api_key_here
# BHUVAN_BASE_URL=https://bhuvan.nrsc.gov.in/

# --- USGS Earthdata (Landsat) ---
# USGS_USERNAME=your_usgs_username
# USGS_PASSWORD=your_usgs_password
# USGS_BASE_URL=https://earthexplorer.usgs.gov/

# --- CPCB / OpenAQ (Air Quality) ---
# OPENAQ_API_KEY=your_openaq_api_key_here
# OPENAQ_BASE_URL=https://api.openaq.org/v3/

# --- Census / Data.gov.in ---
# DATAGOV_API_KEY=your_datagov_api_key_here

# --- App settings ---
APP_ENV=development
LOG_LEVEL=INFO
